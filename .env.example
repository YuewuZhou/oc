# .env.example — copy to .env and fill in your values.
#
#   cp .env.example .env
#   # edit .env, then test:
#   echo "say hello" | bash bin/greg.sh

# ── Claude / Chris ───────────────────────────────────────────────────────────
# Used by: Claude Code CLI, Chris subagents (claude -p)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── DeepSeek / Derek ─────────────────────────────────────────────────────────
# Used by: Derek subagents (derek.sh)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# Model used by Derek. deepseek-v4-flash (fast) or deepseek-v4-pro (capable).
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Gemini / Greg ────────────────────────────────────────────────────────────
# Used by: Greg subagents
# Get from: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=AIza...
# Model used by Greg. Change here to switch models globally.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── OpenAI / Owen ────────────────────────────────────────────────────────────
# Used by: Owen subagents (owen.sh) and interactive `owen` session
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Model used by Owen. OWEN_MODEL overrides OPENAI_MODEL for owen.sh.
OWEN_MODEL=gpt-4o
OPENAI_MODEL=4o-mini

# ── Groq / Greta ─────────────────────────────────────────────────────────────
# Used by: groq.sh, ProviderAgent(groq)
# Get from: https://console.groq.com/keys (free tier, rate-limited)
GROQ_API_KEY=gsk_...
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenRouter / Robin ────────────────────────────────────────────────────────
# Used by: router.sh, ProviderAgent(router)
# Get from: https://openrouter.ai/settings/keys (free :free models, no billing needed)
OPENROUTER_API_KEY=sk-or-...
# Append :free to use free models. See: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── NVIDIA NIM / Nina ─────────────────────────────────────────────────────────
# Used by: nim.sh, ProviderAgent(nim)
# Get from: https://build.nvidia.com/ (free credits on signup)
NVIDIA_API_KEY=nvapi-...
# Options: meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Mistral / Mira ────────────────────────────────────────────────────────────
# Used by: mistral.sh, ProviderAgent(mistral)
# Get from: https://console.mistral.ai/api-keys/ (free tier available)
MISTRAL_API_KEY=...
# Options: mistral-small-latest (free tier), open-mistral-7b, mistral-medium-latest
MISTRAL_MODEL=mistral-small-latest

# ── GitHub Models / Gabby ─────────────────────────────────────────────────────
# Used by: github.sh, ProviderAgent(github)
# Get from: https://github.com/settings/tokens (any GitHub account, free)
GITHUB_TOKEN=github_pat_...
# Options: gpt-4o-mini, Phi-4, meta-llama/Meta-Llama-3.1-70B-Instruct, mistral-large-2411
GITHUB_MODEL=gpt-4o-mini

# ── Email (Jarvan SMTP/IMAP) ─────────────────────────────────────────────────
# Used by: tools/email/send_report.py, poll_once.py
# Gmail app password — NOT your account password.
# Get from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-gmail@gmail.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-gmail@gmail.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=30
