# .env.example — copy to .env and fill in your values.
#
#   cp .env.example .env
#   # edit .env, then test:
#   echo "say hello" | bash bin/greg.sh

# ── Claude / Chris ───────────────────────────────────────────────────────────
# Used by: Claude Code CLI, Chris subagents (claude -p)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── DeepSeek / Derek ─────────────────────────────────────────────────────────
# Used by: Derek subagents (derek.sh)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# Model used by Derek. deepseek-v4-flash (fast) or deepseek-v4-pro (capable).
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Gemini / Greg ────────────────────────────────────────────────────────────
# Used by: Greg subagents
# Get from: https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=AIza...
# Model used by Greg. Change here to switch models globally.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── OpenAI / Owen ────────────────────────────────────────────────────────────
# Used by: Owen subagents (owen.sh) and interactive `owen` session
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Model used by Owen. OWEN_MODEL overrides OPENAI_MODEL for owen.sh.
OWEN_MODEL=gpt-4o
OPENAI_MODEL=4o-mini

# ── Email (Jarvan SMTP/IMAP) ─────────────────────────────────────────────────
# Used by: tools/email/send_report.py, poll_once.py
# Gmail app password — NOT your account password.
# Get from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-gmail@gmail.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-gmail@gmail.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=30
